{
  "name": "@zakkster/lite-bmfont",
  "version": "1.6.1",
  "description": "Zero-GC bitmap font canvas renderer. O(1) kerning via 64K Int16 LUT, multi-line alignment, zero-alloc numeric HUD output, and pre-laid-out wrapped text with H/V alignment + ellipsis.",
  "author": "Zahary Shinikchiev <shinikchiev@yahoo.com>",
  "license": "MIT",
  "type": "module",
  "main": "./BitmapFont.js",
  "module": "./BitmapFont.js",
  "types": "./BitmapFont.d.ts",
  "exports": {
    ".": {
      "types": "./BitmapFont.d.ts",
      "node": "./BitmapFont.js",
      "import": "./BitmapFont.js",
      "default": "./BitmapFont.js"
    }
  },
  "files": [
    "BitmapFont.js",
    "BitmapFont.d.ts",
    "README.md",
    "CHANGELOG.md",
    "llms.txt",
    "LICENSE"
  ],
  "keywords": [
    "bmfont",
    "bitmap-font",
    "canvas",
    "canvas2d",
    "text",
    "text-rendering",
    "kerning",
    "word-wrap",
    "text-wrap",
    "alignment",
    "ellipsis",
    "hud",
    "game-text",
    "zero-gc",
    "zero-alloc",
    "typed-array"
  ],
  "sideEffects": false,
  "homepage": "https://github.com/PeshoVurtoleta/lite-bmfont#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeshoVurtoleta/lite-bmfont.git"
  },
  "bugs": {
    "url": "https://github.com/PeshoVurtoleta/lite-bmfont/issues",
    "email": "shinikchiev@yahoo.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/PeshoVurtoleta"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@zakkster/lite-gc-profiler": "^1.12.0",
    "@zakkster/lite-leak": "^1.8.0"
  },
  "scripts": {
    "test": "node --expose-gc --test test/*.test.js",
    "test:watch": "node --test --watch test/*.test.js",
    "torture": "node --expose-gc test/torture.mjs",
    "verify": "npm test && npm run torture",
    "smoke": "node -e \"import('./BitmapFont.js').then(m => { if (typeof m.BitmapFont !== 'function' || typeof m.VERSION !== 'string') { process.exit(1); } })\"",
    "prepublishOnly": "npm run verify && npm run smoke"
  }
}
